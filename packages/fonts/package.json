{
	"name": "@w1c/fonts",
	"version": "0.0.0",
	"description": "Theme font CSS and bundled classic Mac webfonts for W1C.",
	"license": "MIT",
	"type": "module",
	"homepage": "https://github.com/desertthunder/w1c#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/desertthunder/w1c.git",
		"directory": "packages/fonts"
	},
	"bugs": {
		"url": "https://github.com/desertthunder/w1c/issues"
	},
	"keywords": [
		"fonts",
		"css",
		"fontsource",
		"retro",
		"classic-mac",
		"windows-95",
		"geocities",
		"ubuntu"
	],
	"exports": {
		"./all.css": "./dist/all.css",
		"./classic-mac.css": "./dist/classic-mac.css",
		"./geocities.css": "./dist/geocities.css",
		"./ubuntu.css": "./dist/ubuntu.css",
		"./windows.css": "./dist/windows.css",
		"./classic-mac/ChicagoFLF.woff2": "./dist/classic-mac/ChicagoFLF.woff2",
		"./classic-mac/ChiKareGo2.woff2": "./dist/classic-mac/ChiKareGo2.woff2",
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "rm -rf dist && mkdir -p dist && cp -R src/. dist/",
		"format": "prettier --write . --ignore-path ../../.prettierignore"
	},
	"dependencies": {
		"@fontsource-variable/ibm-plex-sans": "^5.2.8",
		"@fontsource/anonymous-pro": "^5.2.8",
		"@fontsource/comic-neue": "^5.2.7",
		"@fontsource/comic-relief": "^5.2.2",
		"@fontsource/ibm-plex-mono": "^5.2.7",
		"@fontsource/ibm-plex-serif": "^5.2.7",
		"@fontsource/ubuntu": "^5.2.8",
		"@fontsource/ubuntu-mono": "^5.2.8"
	},
	"devDependencies": {
		"prettier": "^3.8.3"
	}
}
