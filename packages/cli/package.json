{
	"name": "@w1c/cli",
	"version": "0.0.0",
	"description": "Command-line scaffolding and terminal docs for W1C web components.",
	"license": "MIT",
	"type": "module",
	"homepage": "https://github.com/desertthunder/w1c#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/desertthunder/w1c.git",
		"directory": "packages/cli"
	},
	"bugs": {
		"url": "https://github.com/desertthunder/w1c/issues"
	},
	"keywords": [
		"cli",
		"scaffold",
		"web-components",
		"lit",
		"retro",
		"themes"
	],
	"bin": {
		"w1c": "./dist/main.mjs"
	},
	"exports": {
		".": {
			"types": "./dist/main.d.mts",
			"import": "./dist/main.mjs"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"docs:manifest": "tsx src/manifest.ts",
		"dev": "pnpm run docs:manifest && tsx src/main.ts",
		"build": "pnpm run docs:manifest && tsdown src/main.ts --format esm --dts --clean",
		"check": "pnpm run docs:manifest && tsc --noEmit",
		"test": "vitest --run",
		"format": "prettier --write . --ignore-path ../../.prettierignore"
	},
	"dependencies": {
		"@clack/prompts": "^1.5.1",
		"cac": "^7.0.0",
		"chalk": "^5.6.2",
		"execa": "^9.6.1",
		"fs-extra": "^11.3.5",
		"marked": "^16.4.1"
	},
	"devDependencies": {
		"@types/fs-extra": "^11.0.4",
		"@types/node": "^24.10.2",
		"prettier": "^3.8.3",
		"tsdown": "^0.22.2",
		"tsx": "^4.21.0",
		"typescript": "~6.0.2",
		"vitest": "^4.1.8"
	}
}
