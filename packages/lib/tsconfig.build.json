{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"allowImportingTsExtensions": false,
		"declaration": true,
		"emitDeclarationOnly": false,
		"noEmit": false,
		"outDir": "dist",
		"rootDir": "src",
		"sourceMap": true
	},
	"include": ["src/**/*.ts"],
	"exclude": ["src/**/*.test.ts", "src/test"]
}
