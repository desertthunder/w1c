	"files": [
		"dist/**/*.js",
		"dist/**/*.js.map",
		"dist/**/*.d.ts",
		"dist/themes",
		"dist/styles",
		"dist/static",
		"README.md"
	],
	"scripts": {
		"dev": "vite",
		"build": "pnpm --filter @w1c/dnd build && rm -rf dist && tsc -p tsconfig.build.json && mkdir -p dist/themes dist/styles dist/static && cp src/themes/*.css dist/themes/ && cp src/styles/*.css dist/styles/ && cp public/favicon.svg public/icons.svg dist/static/",
		"preview": "vite preview",
		"check": "pnpm --filter @w1c/dnd build && tsc --noEmit",
		"test": "pnpm --filter @w1c/dnd build && vitest --run",
		"format": "prettier --write . --ignore-path ../../.prettierignore"
	},
	"dependencies": {
		"@w1c/dnd": "workspace:^0.1.0-next.0",
		"@w1c/fonts": "workspace:^0.1.0-next.0",
		"lit": "^3.3.2"
	},
